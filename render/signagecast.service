[Unit]
Description=SignageCast – Datendienst (TV-Seite, Streamliste, Wache, API für die Verwaltung; nur 127.0.0.1:8080)
After=network-online.target
Wants=network-online.target

[Service]
User=signagecast
# optionale Einstellungen wie SC_STREAM_PORT=… (legt installieren.sh an, wenn beim Installieren angegeben)
EnvironmentFile=-/etc/signagecast/umgebung
ExecStart=/usr/bin/python3 -I /opt/signagecast/app/dienst.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
